# Reference server
PORT=3003

# Buyer's Supabase project URL.
SUPABASE_URL=

# Public/auth verification key. Prefer the modern publishable key.
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only for older projects; do not set both unless migrating.
SUPABASE_ANON_KEY=

# SERVER ONLY. Required by the MT-MP-02 persistence adapters.
# Never expose this value through NEXT_PUBLIC_*, VITE_*, browser bundles, or client logs.
SUPABASE_SECRET_KEY=
# Legacy server-key fallback supported for older projects.
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider credentials. Only one is needed for /ai/demo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional buyer-owned Stripe credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
