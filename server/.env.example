# Environment variable reference for the Multi-Tenant AI Starter Kit (MT01).
#
# THIS FILE IS DOCUMENTATION ONLY — IT IS NOT LOADED.
# There is no dotenv in this project and nothing reads a .env file. Creating a
# .env file, or copying this file to .env, has NO effect: the server will not
# read it. Supply these values to the PROCESS instead — export them in the shell
# that starts the server, set them in your supervisor's Environment=/
# EnvironmentFile= directive, or put them in your platform's secret store.
# See docs/house-swarm-7/WU5-DEPLOY.md section 3.3.
#
# Every variable the server reads is listed here: thirteen in total. Lines marked
# "optional" may be left unset. No value in this file is a real credential, and
# there is no address or key here you may use.

# Server port (optional; default 3003 when unset)
# พอร์ตของเซิร์ฟเวอร์ (ไม่บังคับ; ค่าเริ่มต้น 3003 เมื่อไม่ตั้ง)
PORT=3003

# Node.js environment (recommended: set to "production" on a real deployment).
# This is what activates the DEMO_AUTH refusal described below.
# สภาพแวดล้อมของ Node.js (แนะนำ: ตั้งเป็น "production" บน deploy จริง)
# นี่คือสิ่งที่ทำให้การปฏิเสธ DEMO_AUTH ด้านล่างทำงาน
NODE_ENV=development

# PostgreSQL connection string (required for the real database).
# Unset = the server keeps its in-memory repositories and persists NOTHING when
# the process stops. The buyer supplies this value; there is no default address
# anywhere in this repository.
# Keep the sslmode parameter for Supabase Postgres, e.g. ?sslmode=require —
# the pg driver turns it into TLS settings.
# connection string ของ PostgreSQL (จำเป็นสำหรับฐานข้อมูลจริง)
# ถ้าไม่ตั้ง = เซิร์ฟเวอร์ใช้ repository ในหน่วยความจำ และไม่เก็บอะไรเลยเมื่อโปรเซสหยุด
# ผู้ซื้อเป็นผู้ใส่ค่านี้เอง ไม่มีที่อยู่เริ่มต้นในที่เก็บโค้ดนี้
# ให้เก็บพารามิเตอร์ sslmode ไว้สำหรับ Supabase Postgres เช่น ?sslmode=require
# ไดรเวอร์ pg จะแปลงเป็นค่าตั้ง TLS ให้เอง
DATABASE_URL=

# Demonstration identity gate (NEVER enable this in production).
# WARNING: DEMO_AUTH=true is NOT authentication. It establishes a tenant identity
# from a caller-supplied header, with no password, no user record, no token and
# no signature. Leave this EMPTY/unset on any real deployment.
# The server enforces this: with NODE_ENV=production AND DEMO_AUTH=true it refuses
# to mount the gate, logs a line beginning "[demo-auth] REFUSED:", and answers 503
# with code DEMO_AUTH_REFUSED_IN_PRODUCTION on the protected routes.
# gate ตัวตนสาธิต (ห้ามเปิดบน production เด็ดขาด)
# คำเตือน: DEMO_AUTH=true ไม่ใช่การยืนยันตัวตน มันสร้างตัวตน tenant จาก header ที่ผู้เรียก
# ส่งมา โดยไม่มีรหัสผ่าน ไม่มีบัญชีผู้ใช้ ไม่มีโทเคน และไม่มีลายเซ็น
# ให้เว้นว่าง/ไม่ตั้ง บน deploy จริงทุกกรณี
# เซิร์ฟเวอร์บังคับกฎนี้เอง: ถ้า NODE_ENV=production พร้อม DEMO_AUTH=true มันจะปฏิเสธ
# ไม่ mount gate พิมพ์บรรทัดที่ขึ้นต้นด้วย "[demo-auth] REFUSED:" และตอบ 503
# พร้อมรหัส DEMO_AUTH_REFUSED_IN_PRODUCTION บนเส้นทางที่ป้องกันไว้
DEMO_AUTH=

# Buyer's own Supabase project URL obtained from their Supabase dashboard (not this platform's)
SUPABASE_URL=
# Buyer's own Supabase project anon/public API key obtained from their Supabase dashboard (not this platform's)
SUPABASE_ANON_KEY=

# Optional: OpenAI API key (only one AI provider key is required to exercise the /ai/demo endpoint)
OPENAI_API_KEY=
# Optional: Anthropic API key (only one AI provider key is required to exercise the /ai/demo endpoint)
ANTHROPIC_API_KEY=
# Optional: Google Gemini API key (only one AI provider key is required to exercise the /ai/demo endpoint)
GEMINI_API_KEY=

# Optional: Buyer's own Stripe secret key (test mode sk_test_... recommended to exercise payment demo)
STRIPE_SECRET_KEY=
# Optional: Buyer's own Stripe webhook signing secret (whsec_... for verifying incoming webhooks)
STRIPE_WEBHOOK_SECRET=

# Optional: rate limit for POST /payment/webhook — the number of requests
# allowed per window. Unit: REQUESTS (a count, not seconds). When unset or
# empty, the default 60 applies.
# A value that is not a positive integer (zero, negative, non-numeric) is
# rejected, clamped to the default 60, and one warning line is logged: a bad
# value can never disable the limiter.
# ไม่บังคับ: rate limit ของ POST /payment/webhook — จำนวนคำขอที่อนุญาตต่อหนึ่งหน้าต่าง
# หน่วย: จำนวนคำขอ (ไม่ใช่วินาที) ถ้าไม่ตั้งหรือว่าง ค่าเริ่มต้น 60 จะถูกใช้
# ค่าที่ไม่ใช่จำนวนเต็มบวก (ศูนย์ ติดลบ ไม่ใช่ตัวเลข) จะถูกปฏิเสธ ถูก clamp เป็น 60
# และพิมพ์คำเตือนหนึ่งบรรทัด: ค่าที่ผิดจะปิด limiter ไม่ได้เด็ดขาด
WEBHOOK_RATE_LIMIT_MAX=

# Optional: length of the rate limit window for POST /payment/webhook.
# Unit: MILLISECONDS (ms), not seconds. When unset or empty, the default 60000
# applies, i.e. 60 requests per 60 seconds.
# ไม่บังคับ: ความยาวหน้าต่างของ rate limit สำหรับ POST /payment/webhook
# หน่วย: มิลลิวินาที (ms) ไม่ใช่วินาที ถ้าไม่ตั้งหรือว่าง ค่าเริ่มต้น 60000 จะถูกใช้
# คือ 60 คำขอต่อ 60 วินาที
WEBHOOK_RATE_LIMIT_WINDOW_MS=
