# Server port configuration (additional environment variables will be added in subsequent build rounds)
PORT=3003

# Buyer's own Supabase project URL obtained from their Supabase dashboard (not this platform's)
SUPABASE_URL=
# Buyer's own Supabase project anon/public API key obtained from their Supabase dashboard (not this platform's)
SUPABASE_ANON_KEY=

# Optional: OpenAI API key (only one AI provider key is required to exercise the /ai/demo endpoint)
OPENAI_API_KEY=
# Optional: Anthropic API key (only one AI provider key is required to exercise the /ai/demo endpoint)
ANTHROPIC_API_KEY=
# Optional: Google Gemini API key (only one AI provider key is required to exercise the /ai/demo endpoint)
GEMINI_API_KEY=

# Optional: Buyer's own Stripe secret key (test mode sk_test_... recommended to exercise payment demo)
STRIPE_SECRET_KEY=
# Optional: Buyer's own Stripe webhook signing secret (whsec_... for verifying incoming webhooks)
STRIPE_WEBHOOK_SECRET=

